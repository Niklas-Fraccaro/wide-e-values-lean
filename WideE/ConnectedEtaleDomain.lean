import WideE.EtaleFiniteFree
import Mathlib.RingTheory.Filtration
import Mathlib.RingTheory.LocalProperties.Basic
import Mathlib.RingTheory.Spectrum.Prime.Noetherian
import Mathlib.RingTheory.Unramified.LocalRing

/-! A connected finite étale Laurent algebra is a domain. -/

noncomputable section

namespace WideE

section LocalRing

variable {B : Type*} [CommRing B] [IsLocalRing B]

private theorem exists_pow_mul_unit_of_not_mem_pow
    (π : B) (hπ : Ideal.span {π} = IsLocalRing.maximalIdeal B)
    (N : ℕ) (x : B) (hx : x ∉ IsLocalRing.maximalIdeal B ^ N) :
    ∃ n : ℕ, ∃ u : B, IsUnit u ∧ x = π ^ n * u := by
  induction N generalizing x with
  | zero => exact False.elim (hx (by simp))
  | succ n ih =>
      by_cases hu : IsUnit x
      · exact ⟨0, x, hu, by rw [pow_zero, one_mul]⟩
      have hm : x ∈ IsLocalRing.maximalIdeal B := (IsLocalRing.mem_maximalIdeal x).mpr hu
      rw [← hπ, Ideal.mem_span_singleton] at hm
      obtain ⟨y, rfl⟩ := hm
      have hy : y ∉ IsLocalRing.maximalIdeal B ^ n := by
        intro h
        apply hx
        rw [← hπ, Ideal.span_singleton_pow, Ideal.mem_span_singleton] at h ⊢
        obtain ⟨z, rfl⟩ := h
        exact ⟨z, by rw [pow_succ', mul_assoc]⟩
      obtain ⟨j, v, hv, rfl⟩ := ih y hy
      exact ⟨j + 1, v, hv, by rw [pow_succ', mul_assoc]⟩

/-- A Noetherian local ring whose maximal ideal is generated by a regular
element, or by zero, is a domain. -/
theorem isDomain_of_principal_maximalIdeal [IsNoetherianRing B]
    (π : B) (hπ : Ideal.span {π} = IsLocalRing.maximalIdeal B)
    (hRegular : π ≠ 0 → ∀ x : B, π * x = 0 → x = 0) : IsDomain B := by
  have hPow : ∀ n : ℕ, π ^ n ≠ 0 → ∀ z : B, π ^ n * z = 0 → z = 0 := by
    intro n
    induction n with
    | zero => simpa only [pow_zero, one_mul] using fun (_ : (1 : B) ≠ 0) _ h => h
    | succ n ih =>
        intro hn z hz
        rw [pow_succ'] at hn hz
        have hπ0 : π ≠ 0 := fun h => hn (by rw [h, zero_mul])
        have hn0 : π ^ n ≠ 0 := fun h => hn (by rw [h, mul_zero])
        exact ih hn0 z (hRegular hπ0 _ (by simpa only [mul_assoc] using hz))
  letI : NoZeroDivisors B := ⟨by
    intro x y hxy
    by_cases hx : x = 0
    · exact Or.inl hx
    right
    have hEx : ∃ N : ℕ, x ∉ IsLocalRing.maximalIdeal B ^ N := by
      by_contra h
      have hEach (N : ℕ) : x ∈ IsLocalRing.maximalIdeal B ^ N :=
        Classical.byContradiction fun hn => h ⟨N, hn⟩
      have hAll := Ideal.mem_iInf.mpr hEach
      rw [Ideal.iInf_pow_eq_bot_of_isLocalRing _ (IsLocalRing.maximalIdeal.isMaximal B).ne_top] at hAll
      exact hx (Ideal.mem_bot.mp hAll)
    obtain ⟨N, hN⟩ := hEx
    obtain ⟨n, u, hu, he⟩ := exists_pow_mul_unit_of_not_mem_pow π hπ N x hN
    have hn : π ^ n ≠ 0 := fun hn => hx (by rw [he, hn, zero_mul])
    have h := hPow n hn (u * y) (by simpa only [he, mul_assoc] using hxy)
    exact hu.mul_right_eq_zero.mp h⟩
  exact NoZeroDivisors.to_isDomain B

end LocalRing

section Localization

variable {R A : Type*} [CommRing R] [IsDomain R] [IsPrincipalIdealRing R] [CommRing A]
variable [Algebra R A] [NoZeroSMulDivisors R A]
variable [Module.Finite R A] [Algebra.FormallyUnramified R A]

include R in
/-- The local ring of a finite torsion-free unramified algebra over a PID at
any prime is a domain. -/
theorem localization_atPrime_isDomain_of_unramified_pid (p : Ideal A) [p.IsPrime] :
    IsDomain (Localization.AtPrime p) := by
  let B := Localization.AtPrime p
  let q := p.comap (algebraMap R A)
  letI : q.IsPrime := Ideal.IsPrime.comap (algebraMap R A)
  letI : p.LiesOver q := ⟨rfl⟩
  letI : Algebra.IsUnramifiedAt R p := by
    change Algebra.FormallyUnramified R B
    letI : Algebra.FormallyUnramified A B := Algebra.FormallyUnramified.of_isLocalization p.primeCompl
    exact Algebra.FormallyUnramified.comp R A B
  have hm : Ideal.map (algebraMap R B) q = IsLocalRing.maximalIdeal B :=
    ((Algebra.isUnramifiedAt_iff_map_eq R q p).mp inferInstance).2
  let π := Submodule.IsPrincipal.generator q
  have hπ : Ideal.span {π} = q := Ideal.span_singleton_generator q
  have hgen : Ideal.span {algebraMap R B π} = IsLocalRing.maximalIdeal B := by
    rw [← hm, ← hπ, Ideal.map_span, Set.image_singleton]
  letI : IsNoetherianRing A := IsNoetherianRing.of_finite R A
  letI : IsNoetherianRing B := IsLocalization.isNoetherianRing p.primeCompl B inferInstance
  apply isDomain_of_principal_maximalIdeal _ hgen
  intro hπB z hz
  have hπ0 : π ≠ 0 := fun h => hπB (by rw [h, map_zero])
  obtain ⟨x, s, rfl⟩ := IsLocalization.mk'_surjective p.primeCompl z
  have h := congrArg (fun y : B => y * algebraMap A B (s : A)) hz
  simp only [zero_mul, mul_assoc, IsLocalization.mk'_spec] at h
  rw [IsScalarTower.algebraMap_apply R A B, ← map_mul] at h
  obtain ⟨t, ht⟩ := (IsLocalization.map_eq_zero_iff p.primeCompl B _).mp h
  have hT : π • ((t : A) * x) = 0 := by
    rw [Algebra.smul_def, mul_left_comm]
    exact ht
  exact (IsLocalization.mk'_eq_zero_iff x s).mpr ⟨t, (smul_eq_zero.mp hT).resolve_left hπ0⟩

end Localization

section Connected

variable {A : Type*} [CommRing A]

private def vanishingInLocalRing (a : A) : Set (PrimeSpectrum A) :=
  {p | algebraMap A (Localization.AtPrime p.asIdeal) a = 0}

private theorem isOpen_vanishingInLocalRing (a : A) :
    IsOpen (vanishingInLocalRing a) := by
  let I := (Submodule.span A {a}).annihilator
  have hI (r : A) : r ∈ I ↔ r * a = 0 := Submodule.mem_annihilator_span_singleton a r
  have h : vanishingInLocalRing a = (PrimeSpectrum.zeroLocus (I : Set A))ᶜ := by
    ext p
    change algebraMap A (Localization.AtPrime p.asIdeal) a = 0 ↔
      p ∉ PrimeSpectrum.zeroLocus (I : Set A)
    rw [IsLocalization.map_eq_zero_iff p.asIdeal.primeCompl, PrimeSpectrum.mem_zeroLocus,
      Set.not_subset]
    exact ⟨fun ⟨s, hs⟩ => ⟨s.val, (hI _).mpr hs, s.property⟩,
      fun ⟨s, h₁, h₂⟩ => ⟨⟨s, h₂⟩, (hI _).mp h₁⟩⟩
  rw [h]
  exact (PrimeSpectrum.isClosed_zeroLocus _).isOpen_compl

private theorem isClopen_vanishingInLocalRing [IsNoetherianRing A]
    (hLoc : ∀ p : PrimeSpectrum A, IsDomain (Localization.AtPrime p.asIdeal)) (a : A) :
    IsClopen (vanishingInLocalRing a) := by
  classical
  let I := (Submodule.span A {a}).annihilator
  obtain ⟨g, hg⟩ := IsNoetherian.noetherian I
  have hI (r : A) : r ∈ I ↔ r * a = 0 := Submodule.mem_annihilator_span_singleton a r
  have h : (vanishingInLocalRing a)ᶜ = ⋂ s ∈ g, vanishingInLocalRing s := by
    ext p
    let B := Localization.AtPrime p.asIdeal
    letI : IsDomain B := hLoc p
    let f := algebraMap A B
    simp only [Set.mem_compl_iff, vanishingInLocalRing, Set.mem_setOf_eq, Set.mem_iInter]
    constructor
    · intro ha s hs
      have hsI : s ∈ I := hg ▸ Submodule.subset_span hs
      have he := congrArg f ((hI s).mp hsI)
      rw [map_mul, map_zero] at he
      exact (mul_eq_zero.mp he).resolve_right ha
    · intro hAll ha
      have hAnn : I ≤ RingHom.ker f := by
        rw [← hg, Submodule.span_le]
        exact hAll
      obtain ⟨s, hs⟩ := (IsLocalization.map_eq_zero_iff p.asIdeal.primeCompl B a).mp ha
      exact (IsLocalization.map_units B s).ne_zero (hAnn ((hI _).mpr hs))
  refine ⟨?_, isOpen_vanishingInLocalRing a⟩
  rw [← isOpen_compl_iff, h]
  exact isOpen_biInter_finset fun _ _ => isOpen_vanishingInLocalRing _

private theorem eq_zero_of_all_localRings (a : A)
    (h : ∀ p : PrimeSpectrum A, algebraMap A (Localization.AtPrime p.asIdeal) a = 0) : a = 0 := by
  apply eq_zero_of_localization
  intro p hp
  exact h ⟨p, hp.isPrime⟩

/-- A Noetherian ring with connected spectrum and domain localizations at each
prime is a domain. -/
theorem isDomain_of_connected_localDomains [IsNoetherianRing A] [ConnectedSpace (PrimeSpectrum A)]
    (hLoc : ∀ p : PrimeSpectrum A, IsDomain (Localization.AtPrime p.asIdeal)) : IsDomain A := by
  letI : Nontrivial A := by
    let p : PrimeSpectrum A := Classical.choice inferInstance
    letI := hLoc p
    exact (algebraMap A (Localization.AtPrime p.asIdeal)).domain_nontrivial
  letI : NoZeroDivisors A := ⟨by
    intro a b hab
    by_cases ha : a = 0
    · exact Or.inl ha
    right
    obtain hEmpty | hAll := (isClopen_iff.mp (isClopen_vanishingInLocalRing hLoc a))
    · apply eq_zero_of_all_localRings
      intro p
      letI := hLoc p
      have ha' : algebraMap A (Localization.AtPrime p.asIdeal) a ≠ 0 := by
        intro he
        have hp : p ∈ vanishingInLocalRing a := he
        rw [hEmpty] at hp
        exact hp
      have he := congrArg (algebraMap A (Localization.AtPrime p.asIdeal)) hab
      rw [map_mul, map_zero] at he
      exact (mul_eq_zero.mp he).resolve_left ha'
    · apply False.elim
      apply ha
      apply eq_zero_of_all_localRings
      intro p
      change p ∈ vanishingInLocalRing a
      rw [hAll]
      exact Set.mem_univ p⟩
  exact NoZeroDivisors.to_isDomain A

end Connected

universe u

/-- A connected, finite étale algebra over the Laurent line of an algebraically
closed field is a domain. Its coefficient algebra is the canonical one. -/
theorem isDomain_of_connected_finiteEtaleLaurent {K A : Type u} [Field K] [IsAlgClosed K]
    [CommRing A] [Algebra (LaurentPolynomial K) A] [ConnectedSpace (PrimeSpectrum A)]
    [Module.Finite (LaurentPolynomial K) A] [Algebra.Etale (LaurentPolynomial K) A] :
    IsDomain A := by
  let R := LaurentPolynomial K
  letI : Algebra K A := ((algebraMap R A).comp (algebraMap K R)).toAlgebra
  letI : IsScalarTower K R A := IsScalarTower.of_algebraMap_eq fun _ => rfl
  letI : Module.Free R A := moduleFree_of_finiteEtaleLaurent (K := K) (A := A)
  letI : IsNoetherianRing A := IsNoetherianRing.of_finite R A
  exact isDomain_of_connected_localDomains fun p =>
    localization_atPrime_isDomain_of_unramified_pid (R := R) p.asIdeal

end WideE
