import WideE.LaurentEtaleFiber
import AlgebraicPoint
import Mathlib.Algebra.Module.Torsion
import Mathlib.RingTheory.Finiteness.Nakayama
import Mathlib.RingTheory.UniqueFactorizationDomain.Multiplicity

/-! Finite étale algebras over the Laurent line are finite free. The proof
uses finite-order infinitesimal lifts and Nakayama's lemma over the PID. -/

open scoped TensorProduct

noncomputable section

namespace WideE

attribute [local instance 2000] Algebra.toModule

universe u

section Kernel

variable {K R A : Type u} [CommRing K] [CommRing R] [CommRing A]
variable [Algebra K R] [Algebra K A] [Algebra R A] [IsScalarTower K R A]
variable (f : R →ₐ[K] K)

/-- The kernel of specialization is the submodule generated by the ideal of the base point. -/
theorem evaluationFiberClass_eq_zero_iff (x : A) :
    evaluationFiberClass A f x = 0 ↔
      x ∈ (RingHom.ker f.toRingHom) • (⊤ : Submodule R A) := by
  letI := f.toRingHom.toAlgebra
  change ((1 : K) ⊗ₜ[R] x) = 0 ↔ _
  let g : R →ₐ[R] K := Algebra.ofId R K
  have hSurj : Function.Surjective g := fun a => ⟨algebraMap K R a, f.commutes a⟩
  let I := RingHom.ker g.toRingHom
  let e : (R ⧸ I) ≃ₐ[R] K := Ideal.quotientKerAlgEquivOfSurjective (f := g) hSurj
  have hI : I = RingHom.ker f.toRingHom := by
    have hg : g.toRingHom = f.toRingHom := RingHom.ext fun _ => rfl
    exact congrArg RingHom.ker hg
  suffices h : ((1 : K) ⊗ₜ[R] x) = 0 ↔ x ∈ I • (⊤ : Submodule R A) by
    rw [hI] at h
    exact h
  let E : (K ⊗[R] A) ≃ₗ[R] (A ⧸ (I • (⊤ : Submodule R A))) :=
    e.symm.toLinearEquiv.rTensor A ≪≫ₗ TensorProduct.quotTensorEquivQuotSMul A I
  have he : E ((1 : K) ⊗ₜ[R] x) =
      Submodule.Quotient.mk (p := I • (⊤ : Submodule R A)) x := by
    have h1 : e ((Ideal.Quotient.mk I) 1) = 1 := map_one e
    rw [← h1]
    change TensorProduct.quotTensorEquivQuotSMul A I
      (e.symm (e ((Ideal.Quotient.mk I) 1)) ⊗ₜ[R] x) = _
    rw [AlgEquiv.symm_apply_apply, TensorProduct.quotTensorEquivQuotSMul_mk_tmul, one_smul]
  constructor
  · intro hx
    apply (Submodule.Quotient.mk_eq_zero _).mp
    rw [← he, hx, map_zero]
  · intro hx
    apply E.injective
    rw [he, map_zero]
    exact (Submodule.Quotient.mk_eq_zero _).mpr hx

end Kernel

section InfinitesimalLift

variable {K R A : Type u} [Field K] [CommRing R] [IsDomain R] [IsPrincipalIdealRing R]
variable [CommRing A] [Algebra K R] [Algebra K A] [Algebra R A] [IsScalarTower K R A]
variable [Algebra.Etale R A]

/-- A torsion element vanishes at each point of a fiber above a nonzero
principal prime. The lift to a high enough infinitesimal neighborhood
retains the multiplicity of the annihilator. -/
private theorem torsion_vanishes_at_fiberPoint
    (f : R →ₐ[K] K) {m : Ideal R} (hm : RingHom.ker f.toRingHom = m)
    [m.IsMaximal] {π : R} (hπ : Ideal.span {π} = m) (hπ0 : π ≠ 0)
    {r : R} (hr : r ≠ 0) {x : A} (hx : r • x = 0) (p : EvaluationFiberPoint A f) :
    p.val x = 0 := by
  letI := f.toRingHom.toAlgebra
  let fR : R →ₐ[R] K := Algebra.ofId R K
  have hprime : Prime π := (Ideal.span_singleton_prime hπ0).mp (hπ.symm ▸ inferInstanceAs m.IsPrime)
  obtain ⟨s, hfac, hndvd⟩ := (FiniteMultiplicity.of_prime_left hprime hr).exists_eq_pow_mul_and_not_dvd
  let k := multiplicity π r
  let J := m ^ (k + 1)
  have hSub : J ≤ m := Ideal.pow_le_self (Nat.succ_ne_zero k)
  let hZero (y : R) (hy : y ∈ J) : fR y = 0 :=
    (RingHom.mem_ker (f := f.toRingHom)).mp (hm.symm ▸ hSub hy)
  let g : (R ⧸ J) →ₐ[R] K := Ideal.Quotient.liftₐ J fR hZero
  have hg (y : R) : g (Ideal.Quotient.mk J y) = f y :=
    Ideal.Quotient.lift_mk J fR.toRingHom hZero
  have hSurj : Function.Surjective g :=
    fun t => ⟨Ideal.Quotient.mk J (algebraMap K R t), (hg _).trans (f.commutes t)⟩
  have hgComp : g.toRingHom.comp (Ideal.Quotient.mk J) = f.toRingHom := RingHom.ext hg
  have hKer : m.map (Ideal.Quotient.mk J) = RingHom.ker g.toRingHom := by
    rw [← Ideal.map_comap_of_surjective (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
      (RingHom.ker g.toRingHom), RingHom.comap_ker, hgComp, hm]
  have hNil : IsNilpotent (RingHom.ker g.toRingHom) := by
    refine ⟨k + 1, ?_⟩
    rw [← hKer, ← Ideal.map_pow, Ideal.map_quotient_self, Ideal.zero_eq_bot]
  let pR : A →ₐ[R] K := { p.val.toRingHom with
    commutes' := fun y => DFunLike.congr_fun p.property y }
  let q := Algebra.FormallySmooth.liftOfSurjective pR g hSurj hNil
  have hq : g (q x) = p.val x := Algebra.FormallySmooth.liftOfSurjective_apply pR g hSurj hNil x
  obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective (q x)
  have hAnn := congrArg q hx
  rw [map_zero, Algebra.smul_def, map_mul, AlgHom.commutes, ← hy] at hAnn
  change Ideal.Quotient.mk J r * Ideal.Quotient.mk J y = 0 at hAnn
  rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem] at hAnn
  have hDiv : π ^ (k + 1) ∣ r * y := by
    change r * y ∈ m ^ (k + 1) at hAnn
    rwa [← hπ, Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hAnn
  obtain ⟨v, hv⟩ := hDiv
  change r = π ^ k * s at hfac
  rw [hfac, mul_assoc, pow_succ, mul_assoc] at hv
  have hsY : s * y = π * v := mul_left_cancel₀ (pow_ne_zero _ hπ0) hv
  have hsYMem : s * y ∈ m := by
    rw [← hπ, Ideal.mem_span_singleton]
    exact ⟨v, hsY⟩
  have hsNotMem : s ∉ m := by simpa only [← hπ, Ideal.mem_span_singleton] using hndvd
  have hyMem : y ∈ m := (Ideal.IsPrime.mem_or_mem inferInstance hsYMem).resolve_left hsNotMem
  rw [← hq, ← hy, hg]
  exact (RingHom.mem_ker (f := f.toRingHom)).mp (hm.symm ▸ hyMem)

end InfinitesimalLift

section Torsion

open scoped Pointwise

variable {K R A : Type u} [Field K] [IsAlgClosed K]
variable [CommRing R] [IsDomain R] [IsPrincipalIdealRing R] [CommRing A]
variable [Algebra K R] [Algebra.FiniteType K R] [Algebra K A] [Algebra R A] [IsScalarTower K R A]
variable [Module.Finite R A] [Algebra.Etale R A]

include K in
/-- A finite étale algebra over a principal domain of finite type over an
algebraically closed field has no module torsion. -/
theorem noZeroSMulDivisors_of_finiteEtale : NoZeroSMulDivisors R A := by
  classical
  let T := Submodule.torsion R A
  have hT : T = ⊥ := by
    by_contra hNe
    have hAn : T.annihilator ≠ ⊤ := by
      intro h
      apply hNe
      apply le_bot_iff.mp
      intro x hx
      have hx0 : x = 0 := by
        simpa only [one_smul] using
          Submodule.mem_annihilator.mp ((Ideal.eq_top_iff_one _).mp h) x hx
      exact (Submodule.mem_bot R).mpr hx0
    obtain ⟨m, hM, hAnn⟩ := T.annihilator.exists_le_maximal hAn
    letI := hM
    let π := Submodule.IsPrincipal.generator m
    have hπ : Ideal.span {π} = m := Ideal.span_singleton_generator m
    have hTors : Module.IsTorsion R T := by
      intro x
      obtain ⟨r, hr⟩ := (Submodule.mem_torsion_iff (R := R) _).mp x.property
      exact ⟨r, Subtype.ext hr⟩
    obtain ⟨r, hr, hrNZ⟩ := Set.nonempty_iff_ne_empty.mpr
      (Submodule.annihilator_top_inter_nonZeroDivisors hTors)
    have hrAnn : r ∈ T.annihilator := by
      apply Submodule.mem_annihilator.mpr
      intro x hx
      have eq := Submodule.mem_annihilator.mp hr (⟨x, hx⟩ : T) Submodule.mem_top
      exact congrArg Subtype.val eq
    have hπ0 : π ≠ 0 := by
      intro he
      have hm0 : m = ⊥ := (Submodule.IsPrincipal.eq_bot_iff_generator_eq_zero m).mpr he
      exact nonZeroDivisors.coe_ne_zero (⟨r, hrNZ⟩ : nonZeroDivisors R) (Ideal.mem_bot.mp (hm0 ▸ hAnn hrAnn))
    let f := StrictEUnit.maximalIdealPoint (k := K) m
    have hf : RingHom.ker f.toRingHom = m := StrictEUnit.maximalIdealPoint_ker m
    have hTspan : T ≤ m • T := by
      intro x hx
      have hAnnx := Submodule.mem_annihilator.mp hrAnn x hx
      have hc : evaluationFiberClass A f x = 0 := by
        apply (evaluationFiberEquiv A f).injective
        rw [map_zero]
        funext p
        rw [evaluationFiberEquiv_class]
        exact torsion_vanishes_at_fiberPoint f hf hπ hπ0
          (nonZeroDivisors.coe_ne_zero (⟨r, hrNZ⟩ : nonZeroDivisors R)) hAnnx p
      have hxTop := (evaluationFiberClass_eq_zero_iff f x).mp hc
      rw [hf, ← hπ, Submodule.ideal_span_singleton_smul,
        Submodule.mem_smul_pointwise_iff_exists] at hxTop
      obtain ⟨y, _, rfl⟩ := hxTop
      have hyT : y ∈ T := by
        refine (Submodule.mem_torsion_iff (R := R) _).mpr ⟨⟨r * π, ?_⟩, ?_⟩
        · exact mem_nonZeroDivisors_iff_ne_zero.mpr
            (mul_ne_zero (nonZeroDivisors.coe_ne_zero (⟨r, hrNZ⟩ : nonZeroDivisors R)) hπ0)
        · exact (mul_smul r π y).trans hAnnx
      rw [← hπ, Submodule.ideal_span_singleton_smul, Submodule.mem_smul_pointwise_iff_exists]
      exact ⟨y, hyT, rfl⟩
    obtain ⟨v, hv, hAnnv⟩ := Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul
      m T (IsNoetherian.noetherian T) hTspan
    have hvM : v ∈ m := hAnn (Submodule.mem_annihilator.mpr hAnnv)
    have hone : 1 ∈ m := by
      simpa only [sub_sub_cancel] using m.sub_mem hvM hv
    exact hM.ne_top ((Ideal.eq_top_iff_one m).mpr hone)
  constructor
  intro r x hx
  by_cases hr : r = 0
  · exact Or.inl hr
  · right
    have hxT : x ∈ T := (Submodule.mem_torsion_iff (R := R) _).mpr
      ⟨⟨r, mem_nonZeroDivisors_iff_ne_zero.mpr hr⟩, hx⟩
    exact (Submodule.mem_bot R).mp (hT ▸ hxT)

/-- Finite étale algebras over the Laurent line have a finite Laurent basis. -/
def finiteEtaleLaurentBasis {K A : Type u} [Field K] [IsAlgClosed K] [CommRing A]
    [Algebra K A] [Algebra (LaurentPolynomial K) A] [IsScalarTower K (LaurentPolynomial K) A]
    [Module.Finite (LaurentPolynomial K) A] [Algebra.Etale (LaurentPolynomial K) A] :
    Σ n, Basis (Fin n) (LaurentPolynomial K) A := by
  letI : Algebra.Etale (Polynomial K) (LaurentPolynomial K) :=
    Algebra.Etale.of_isLocalization_Away (Polynomial.X : Polynomial K)
  letI : IsScalarTower K (Polynomial K) (LaurentPolynomial K) :=
    IsScalarTower.of_algebraMap_eq fun x => (Polynomial.toLaurent_C x).symm
  letI : Algebra.FiniteType K (LaurentPolynomial K) :=
    Algebra.FiniteType.trans (S := Polynomial K) inferInstance inferInstance
  letI : NoZeroSMulDivisors (LaurentPolynomial K) A :=
    noZeroSMulDivisors_of_finiteEtale (K := K)
  exact Module.basisOfFiniteTypeTorsionFree'

theorem moduleFree_of_finiteEtaleLaurent {K A : Type u} [Field K] [IsAlgClosed K] [CommRing A]
    [Algebra K A] [Algebra (LaurentPolynomial K) A] [IsScalarTower K (LaurentPolynomial K) A]
    [Module.Finite (LaurentPolynomial K) A] [Algebra.Etale (LaurentPolynomial K) A] :
    Module.Free (LaurentPolynomial K) A :=
  Module.Free.of_basis (finiteEtaleLaurentBasis (K := K) (A := A)).2

end Torsion

end WideE
