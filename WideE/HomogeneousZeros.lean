import Mathlib.RingTheory.Nullstellensatz
import Mathlib.RingTheory.MvPolynomial.Homogeneous
import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis
import Mathlib.RingTheory.Finiteness.Subalgebra

/-!
# Common zeros of homogeneous systems of the same degree

If the common zero locus consists of the origin, the Nullstellensatz puts a power
of each variable in the generated ideal. Homogeneous components then give a finite
module over the algebra generated by the equations, which bounds the transcendence
degree by their number.
-/

noncomputable section

open scoped BigOperators
open MvPolynomial

namespace WideE

section GradedReduction

variable {K : Type*} [Field K] {r s d : ℕ}

attribute [local instance] MvPolynomial.gradedAlgebra

private theorem homogeneousComponent_mul_left {p q : MvPolynomial (Fin r) K} {t : ℕ}
    (hp : p.IsHomogeneous d) (hdt : d ≤ t) :
    homogeneousComponent t (p * q) = p * homogeneousComponent (t - d) q := by
  have h := DirectSum.coe_decompose_mul_of_left_mem_of_le
    (homogeneousSubmodule (Fin r) K) (b := q) hp hdt
  simpa only [DirectSum.decompose, Equiv.coe_fn_mk, decomposition.decompose'_apply] using h

private theorem homogeneous_representation_of_mem_span
    {f : Fin s → MvPolynomial (Fin r) K} (hf : ∀ j, (f j).IsHomogeneous d)
    {g : MvPolynomial (Fin r) K} {t : ℕ} (hg : g.IsHomogeneous t)
    (hdt : d ≤ t) (hmem : g ∈ Ideal.span (Set.range f)) :
    ∃ a : Fin s → MvPolynomial (Fin r) K,
      g = ∑ j, f j * homogeneousComponent (t - d) (a j) := by
  obtain ⟨a, ha⟩ := Ideal.mem_span_range_iff_exists_fun.mp hmem
  refine ⟨a, ?_⟩
  have h := congrArg (homogeneousComponent t) ha
  simpa only [map_sum, mul_comm (a _) (f _), homogeneousComponent_mul_left (hf _) hdt,
    homogeneousComponent_of_mem hg, if_pos rfl] using h.symm

private theorem finite_module_of_variable_powers
    (f : Fin s → MvPolynomial (Fin r) K) (hf : ∀ j, (f j).IsHomogeneous d)
    (hd : 0 < d) {N : ℕ} (hdN : d ≤ N)
    (hN : ∀ i : Fin r, X i ^ N ∈ Ideal.span (Set.range f)) :
    Module.Finite (Algebra.adjoin K (Set.range f)) (MvPolynomial (Fin r) K) := by
  classical
  let R := MvPolynomial (Fin r) K
  let A := Algebra.adjoin K (Set.range f)
  let b (a : Fin r → Fin N) : R :=
    monomial (Finsupp.equivFunOnFinite.symm (fun i => (a i).val)) 1
  let W : Submodule A R := Submodule.span A (Set.range b)
  have hPoly (p : R) (h : ∀ k ∈ p.support, monomial k (1 : K) ∈ W) : p ∈ W := by
    rw [p.as_sum]
    apply W.sum_mem
    intro k hk
    have hterm := W.smul_mem (algebraMap K A (p.coeff k)) (h k hk)
    change C (p.coeff k) * monomial k 1 ∈ W at hterm
    rw [C_mul_monomial, mul_one] at hterm
    exact hterm
  have hMon (t : ℕ) : ∀ k : Fin r →₀ ℕ, k.degree = t → monomial k (1 : K) ∈ W := by
    induction t using Nat.strong_induction_on with
    | h t ih =>
      intro k hk
      by_cases hb : ∀ i, k i < N
      · apply Submodule.subset_span
        refine ⟨fun i => ⟨k i, hb i⟩, ?_⟩
        exact congrArg (fun v : Fin r →₀ ℕ => monomial v (1 : K))
          (Finsupp.equivFunOnFinite.symm_apply_apply k)
      · push_neg at hb
        obtain ⟨i, hi⟩ := hb
        have hki : Finsupp.single i N ≤ k := Finsupp.single_le_iff.mpr hi
        have hSub := add_tsub_cancel_of_le hki
        have hdeg := congrArg Finsupp.degree hSub
        rw [Finsupp.degree_add, Finsupp.degree_single, hk] at hdeg
        have hdt : d ≤ t := by omega
        have hmem : monomial k (1 : K) ∈ Ideal.span (Set.range f) := by
          have hfac : monomial k (1 : K) = X i ^ N * monomial (k - Finsupp.single i N) 1 := by
            rw [X_pow_eq_monomial, monomial_mul, one_mul, hSub]
          rw [hfac]
          exact (Ideal.span (Set.range f)).mul_mem_right _ (hN i)
        have hhom : (monomial k (1 : K)).IsHomogeneous t := isHomogeneous_monomial _ hk
        obtain ⟨a, ha⟩ := homogeneous_representation_of_mem_span hf hhom hdt hmem
        rw [ha]
        apply W.sum_mem
        intro j _
        have hW : homogeneousComponent (t - d) (a j) ∈ W := by
          apply hPoly
          intro l hl
          have hh := homogeneousComponent_isHomogeneous (t - d) (a j)
          have hldeg : l.degree = t - d :=
            (congrFun Finsupp.degree_eq_weight_one l).trans (hh (mem_support_iff.mp hl))
          exact ih (t - d) (by omega) l hldeg
        exact W.smul_mem (⟨f j, Algebra.subset_adjoin (Set.mem_range_self j)⟩ : A) hW
  have hW : W = ⊤ := top_unique fun p _ => hPoly p (fun k _ => hMon k.degree k rfl)
  constructor
  rw [← hW]
  exact Submodule.fg_span (Set.finite_range b)

end GradedReduction

/-- Equally graded positive-degree equations have a nontrivial common zero if there are
fewer equations than variables over an algebraically closed field. -/
theorem exists_homogeneous_common_nonzero_zero {K : Type*} [Field K] [IsAlgClosed K]
    {r s d : ℕ} (f : Fin s → MvPolynomial (Fin r) K) (hf : ∀ j, (f j).IsHomogeneous d)
    (hd : 0 < d) (hsr : s < r) : ∃ x : Fin r → K, x ≠ 0 ∧ ∀ j, eval x (f j) = 0 := by
  classical
  by_contra h
  let I : Ideal (MvPolynomial (Fin r) K) := Ideal.span (Set.range f)
  have h₀ (j : Fin s) : eval (0 : Fin r → K) (f j) = 0 := by
    rw [eval_zero, constantCoeff_eq]
    exact (hf j).coeff_eq_zero (by simpa only [Finsupp.degree_zero] using Nat.ne_of_lt hd)
  have hzero : zeroLocus I = ({0} : Set (Fin r → K)) := by
    dsimp only [I]
    rw [zeroLocus_span]
    ext x
    constructor
    · intro hx
      by_contra hn
      exact h ⟨x, fun hx₀ => hn (Set.mem_singleton_iff.mpr hx₀),
        fun j => hx (f j) (Set.mem_range_self j)⟩
    · intro hx
      have hx₀ := Set.mem_singleton_iff.mp hx
      subst x
      rintro _ ⟨j, rfl⟩
      exact h₀ j
  have hX (i : Fin r) : X i ∈ I.radical := by
    rw [← vanishingIdeal_zeroLocus_eq_radical I, hzero, mem_vanishingIdeal_singleton_iff, eval_X]
    rfl
  choose n hn using fun i => Ideal.mem_radical_iff.mp (hX i)
  let N := max d (Finset.univ.sup n)
  have hN (i : Fin r) : X i ^ N ∈ Ideal.span (Set.range f) := by
    have hle : n i ≤ N := (Finset.le_sup (f := n) (Finset.mem_univ i)).trans (le_max_right _ _)
    exact I.mem_of_dvd (pow_dvd_pow _ hle) (hn i)
  letI := finite_module_of_variable_powers f hf hd (le_max_left _ _) hN
  letI := Algebra.IsAlgebraic.of_finite (Algebra.adjoin K (Set.range f)) (MvPolynomial (Fin r) K)
  have htr := Algebra.IsAlgebraic.trdeg_le_cardinalMk K (Set.range f)
  have hcard := Cardinal.mk_range_le_lift (f := f)
  rw [Cardinal.lift_id', Cardinal.lift_mk_fin] at hcard
  have hbound := htr.trans hcard
  rw [MvPolynomial.trdeg_of_isDomain, Cardinal.lift_mk_fin] at hbound
  exact (Nat.not_le_of_lt hsr) (by exact_mod_cast hbound)

end WideE
