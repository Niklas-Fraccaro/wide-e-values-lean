import WideE.HopfKostantNormalizer
import WideE.HopfKostantUniqueness
import WideE.PrincipalSimpleReflection
import WideE.PrincipalWeights

/-! The principal slice is constant on the simple Weyl reflection orbits of its Cartan term. -/

noncomputable section

open LieAlgebra LieAlgebra.IsKilling LieModule
open scoped Matrix TensorProduct

namespace WideE

section GroupAction

variable {k L A ι : Type*} [Field k] [CharZero k] [LieRing L] [LieAlgebra k L]
  [LieAlgebra ℚ L] [IsScalarTower ℚ k L] [LieAlgebra.IsKilling k L] [FiniteDimensional k L]
  [CommRing A] [HopfAlgebra k A] [Fintype ι] [DecidableEq ι]
  {H : LieSubalgebra k L} [H.IsCartanSubalgebra] [LieModule.IsTriangularizable k H L]

local notation "Φ" => LieAlgebra.IsKilling.rootSystem H
local notation "𝔤" => hopfInvariantDerivations k A
local notation "J" => hopfLieVectorInvariantDerivations (k := k) (H := A)
local notation "W" => negativeEvenWeightSpace (k := k)
local notation "B" => kostantWeightFiltration (k := k)

/-- Each element generated by the simple coreflections acts on the principal affine Cartan slice
through the strictly negative Hopf subgroup. -/
theorem exists_hopfPoint_principalCoreflectionOrbit
    (U : (Matrix ι ι A)ˣ)
    (hD : ∀ i j, Coalgebra.comul (R := k) (U.val i j) = ∑ l, U.val i l ⊗ₜ[k] U.val l j)
    (he : ∀ i j, Coalgebra.counit (R := k) (U.val i j) = if i = j then 1 else 0)
    (hGen : Algebra.adjoin k (Set.range fun ij : ι × ι => U.val ij.1 ij.2) = ⊤)
    (j : L →ₗ⁅k⁆ 𝔤) (b : (Φ).Base) [Fintype b.support]
    (e f : b.support → L)
    (heRoot : ∀ i : b.support, e i ∈ rootSpace H (((Φ).root i : H →ₗ[k] k) : H → k))
    (hfRoot : ∀ i : b.support, f i ∈ rootSpace H (-(((Φ).root i : H →ₗ[k] k) : H → k)))
    (ht : ∀ i : b.support, IsSl2Triple ((Φ).coroot i : L) (e i) (f i))
    (w : H ≃ₗ[k] H) (hw : w ∈ principalSimpleCoreflectionSubgroup b) (z : H) :
    ∃ p : A →ₐ[k] k,
      U.val.map p - 1 ∈ B (hopfLieMatrix U.val (j (principalCartanElement b : L))) 1 ∧
      hopfAdjoint p ((J).symm (j ((∑ i : b.support, e i) + (z : L)))) =
        (J).symm (j ((∑ i : b.support, e i) + (w z : L))) := by
  let h₀ : L := (principalCartanElement b : L)
  let E : L := ∑ i : b.support, e i
  classical
  letI : Group (A →ₐ[k] k) := hopfPointGroup
  letI : Algebra.FiniteType k A := ⟨⟨(Set.finite_range
    (fun ij : ι × ι => U.val ij.1 ij.2)).toFinset, by simpa using hGen⟩⟩
  letI : FiniteDimensional k (HopfCotangent k A) := hopfCotangent_finiteDimensional k A
  let bC := Module.finBasis k (HopfCotangent k A)
  let ρ : L →ₗ⁅k⁆ Matrix ι ι k := (hopfLieMatrixHom U.val hD).comp j
  let a := ρ h₀
  let C := (negativeWeightUnitSubgroup (k := k) a).comap (hopfPointMatrix U hD he)
  let F (y : H) := (J).symm (j (E + (y : L)))
  have hOrbit : ∃ p ∈ C, hopfAdjoint p (F z) = F (w z) := by
    refine Subgroup.closure_induction
      (p := fun v _ => ∀ y : H, ∃ p ∈ C, hopfAdjoint p (F y) = F (v y))
      ?_ ?_ ?_ ?_ hw z
    · rintro _ ⟨i, rfl⟩ y
      obtain ⟨p, hpM, hp⟩ := exists_hopfPoint_principalSimpleReflection U hD he hGen j b e f
        heRoot hfRoot ht i y
      refine ⟨p, ?_, hp⟩
      let u : L := (Φ).root i y • f i
      have hu : u ∈ W h₀ 1 := by
        apply Module.End.mem_eigenspace_iff.mpr
        change ⁅h₀, u⁆ = ((-(2 : ℤ) * (1 : ℤ) : ℤ) : k) • u
        have hf := lie_eq_smul_of_mem_rootSpace (hfRoot i) (principalCartanElement b)
        change ⁅h₀, f i⁆ = -((Φ).root i (principalCartanElement b)) • f i at hf
        rw [principalCartanElement_simpleRoot] at hf
        rw [show u = (Φ).root i y • f i from rfl, lie_smul, hf, smul_comm ((Φ).root i y)]
        norm_num
      have hu₀ : ρ u ∈ B a 1 := negativeEvenWeightSpace_le_filtration a le_rfl
        (lieHom_mem_negativeEvenWeightSpace ρ h₀ hu)
      change (hopfPointMatrix U hD he p).val - 1 ∈ B a 1
      rw [hpM]
      exact exp_sub_one_mem_kostantWeightFiltration a (by decide : 0 < 1) hu₀
    · intro y
      exact ⟨1, C.one_mem, hopfAdjoint_one bC (F y)⟩
    · intro v w _ _ hv hw y
      obtain ⟨rp, hrp, hR⟩ := hw y
      obtain ⟨lp, hlp, hL⟩ := hv (w y)
      refine ⟨lp * rp, C.mul_mem hlp hrp, ?_⟩
      rw [hopfAdjoint_mul bC, hR, hL]
      rfl
    · intro v _ hv y
      obtain ⟨p, hp, hAct⟩ := hv (v⁻¹ y)
      have hy : v (v⁻¹ y) = y := v.apply_symm_apply y
      rw [hy] at hAct
      refine ⟨p⁻¹, C.inv_mem hp, ?_⟩
      rw [← hAct, ← hopfAdjoint_mul bC, inv_mul_cancel]
      exact hopfAdjoint_one bC _
  exact hOrbit

/-- Any two strictly negative normalizations of Cartan terms in the same simple
Weyl orbit have identical slice terms. -/
theorem principalKostantSlice_eq_of_coreflectionOrbit
    (U : (Matrix ι ι A)ˣ)
    (hD : ∀ i j, Coalgebra.comul (R := k) (U.val i j) = ∑ l, U.val i l ⊗ₜ[k] U.val l j)
    (he : ∀ i j, Coalgebra.counit (R := k) (U.val i j) = if i = j then 1 else 0)
    (hGen : Algebra.adjoin k (Set.range fun ij : ι × ι => U.val ij.1 ij.2) = ⊤)
    (j : L →ₗ⁅k⁆ 𝔤) (b : (Φ).Base) [Fintype b.support]
    (e f : b.support → L)
    (heRoot : ∀ i : b.support, e i ∈ rootSpace H (((Φ).root i : H →ₗ[k] k) : H → k))
    (hfRoot : ∀ i : b.support, f i ∈ rootSpace H (-(((Φ).root i : H →ₗ[k] k) : H → k)))
    (ht : ∀ i : b.support, IsSl2Triple ((Φ).coroot i : L) (e i) (f i))
    (hj : Function.Injective j) {f₀ : L}
    (t : IsSl2Triple (principalCartanElement b : L) (∑ i : b.support, e i) f₀)
    (w : H ≃ₗ[k] H) (hw : w ∈ principalSimpleCoreflectionSubgroup b) (z : H)
    (s s' : L) (hs : s ∈ B (principalCartanElement b : L) 0)
    (hs' : s' ∈ B (principalCartanElement b : L) 0)
    (hk : ⁅f₀, s⁆ = 0) (hk' : ⁅f₀, s'⁆ = 0)
    (p p' : A →ₐ[k] k)
    (hp : U.val.map p - 1 ∈ B (hopfLieMatrix U.val (j (principalCartanElement b : L))) 1)
    (hp' : U.val.map p' - 1 ∈ B (hopfLieMatrix U.val (j (principalCartanElement b : L))) 1)
    (hP : hopfAdjoint p ((J).symm (j ((∑ i : b.support, e i) + (z : L)))) = (J).symm (j ((∑ i : b.support, e i) + s)))
    (hP' : hopfAdjoint p' ((J).symm (j ((∑ i : b.support, e i) + (w z : L)))) = (J).symm (j ((∑ i : b.support, e i) + s'))) :
    s = s' := by
  let h₀ : L := (principalCartanElement b : L)
  let E : L := ∑ i : b.support, e i
  classical
  letI : Group (A →ₐ[k] k) := hopfPointGroup
  letI : Algebra.FiniteType k A := ⟨⟨(Set.finite_range
    (fun ij : ι × ι => U.val ij.1 ij.2)).toFinset, by simpa using hGen⟩⟩
  letI : FiniteDimensional k (HopfCotangent k A) := hopfCotangent_finiteDimensional k A
  let bC := Module.finBasis k (HopfCotangent k A)
  let C := (negativeWeightUnitSubgroup (k := k) (hopfLieMatrix U.val (j h₀))).comap
    (hopfPointMatrix U hD he)
  obtain ⟨q, hq, hQ⟩ := exists_hopfPoint_principalCoreflectionOrbit U hD he hGen j b e f
    heRoot hfRoot ht w hw z
  let r := (p' * q) * p⁻¹
  have hr : r ∈ C := C.mul_mem (C.mul_mem hp' hq) (C.inv_mem hp)
  have hrp : r * p = p' * q := by rw [show r = (p' * q) * p⁻¹ from rfl, mul_assoc,
    inv_mul_cancel, mul_one]
  have hR : hopfAdjoint r ((J).symm (j E + j s)) = (J).symm (j E + j s') := by
    rw [← j.map_add, ← j.map_add, ← hP, ← hopfAdjoint_mul bC, hrp, hopfAdjoint_mul bC, hQ, hP']
  have t' : IsSl2Triple (j h₀) (j E) (j f₀) := by
    exact ⟨fun h => t.h_ne_zero (hj (h.trans (j.map_zero).symm)),
      by rw [← j.map_lie, t.lie_e_f],
      by
        rw [← j.map_lie, t.lie_h_e_nsmul]
        exact map_nsmul j.toLinearMap 2 E,
      by
        rw [← j.map_lie, t.lie_h_f_nsmul, j.map_neg]
        exact congrArg Neg.neg (map_nsmul j.toLinearMap 2 f₀)⟩
  have hkJ : ⁅j f₀, j s⁆ = 0 := by rw [← j.map_lie, hk, j.map_zero]
  have hkJ' : ⁅j f₀, j s'⁆ = 0 := by rw [← j.map_lie, hk', j.map_zero]
  exact hj (hopfPoint_eq_one_and_slice_eq_of_kostantAdjoint U hD he hGen t' (j s) (j s')
    (lieHom_mem_kostantWeightFiltration j h₀ hs) (lieHom_mem_kostantWeightFiltration j h₀ hs')
    hkJ hkJ' r hr hR).2

end GroupAction

end WideE
