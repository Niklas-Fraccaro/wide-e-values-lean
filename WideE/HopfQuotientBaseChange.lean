import WideE.HopfPointBaseChange
import WideE.BigCellCentralizer

/-! Base change of a Hopf homomorphism and of an actual Hopf quotient. -/

noncomputable section

open scoped TensorProduct
open StrictEUnit

namespace WideE

variable {k F H J : Type*} [Field k] [CommRing F] [Algebra k F]
  [CommRing H] [HopfAlgebra k H] [CommRing J] [HopfAlgebra k J]

attribute [local instance] hopfScalarExtension

private theorem baseChange_comulMap (f : H →ₐ[k] J) (a : F) (z : H ⊗[k] H) :
    Algebra.TensorProduct.map (weightBaseChangeAlgHom F f) (weightBaseChangeAlgHom F f)
      ((algebraTensorBaseChangeEquiv F H H).symm (a ⊗ₜ[k] z)) =
    (algebraTensorBaseChangeEquiv F J J).symm (a ⊗ₜ[k] Algebra.TensorProduct.map f f z) := by
  induction z using TensorProduct.induction_on with
  | zero => simp only [TensorProduct.tmul_zero, map_zero]
  | add x y hx hy => simp only [TensorProduct.tmul_add, map_add, hx, hy]
  | tmul x y =>
    simp only [algebraTensorBaseChangeEquiv_symm_tmul, Algebra.TensorProduct.map_tmul,
      weightBaseChangeAlgHom_tmul]

/-- The scalar extension of a bialgebra morphism between Hopf algebras. -/
def scalarExtendBialgHom (f : H →ₐc[k] J) : (F ⊗[k] H) →ₐc[F] (F ⊗[k] J) := by
  let f₀ : H →ₐ[k] J := f
  let g := weightBaseChangeAlgHom F f₀
  refine BialgHom.ofAlgHom g (LinearMap.ext fun z => ?_) (LinearMap.ext fun z => ?_)
  · change Bialgebra.counitAlgHom F (F ⊗[k] J) (g z) = Bialgebra.counitAlgHom F (F ⊗[k] H) z
    induction z using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | add x y hx hy => simp only [map_add, hx, hy]
    | tmul a h =>
      change Bialgebra.counitAlgHom F (F ⊗[k] J) (a ⊗ₜ[k] f₀ h) =
        Bialgebra.counitAlgHom F (F ⊗[k] H) (a ⊗ₜ[k] h)
      rw [hopfScalarExtension_counit_tmul, hopfScalarExtension_counit_tmul]
      exact congrArg (fun c : k => a * algebraMap k F c) (CoalgHomClass.counit_comp_apply f h)
  · change Algebra.TensorProduct.map g g (baseChangeComul F z) = baseChangeComul F (g z)
    induction z using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | add x y hx hy => simp only [map_add, hx, hy]
    | tmul a h =>
      change Algebra.TensorProduct.map g g (baseChangeComul F (a ⊗ₜ[k] h)) =
        baseChangeComul F (a ⊗ₜ[k] f₀ h)
      rw [baseChangeComul_tmul, baseChangeComul_tmul]
      rw [show g = weightBaseChangeAlgHom F f₀ from rfl, baseChange_comulMap]
      have hh := CoalgHomClass.map_comp_comul_apply (R := k) f h
      change Algebra.TensorProduct.map f₀ f₀ (Coalgebra.comul (R := k) h) =
        Coalgebra.comul (R := k) (f₀ h) at hh
      rw [hh]

@[simp] theorem scalarExtendBialgHom_tmul (f : H →ₐc[k] J) (a : F) (x : H) :
    scalarExtendBialgHom f (a ⊗ₜ[k] x) = a ⊗ₜ[k] f x := rfl

theorem scalarExtendBialgHom_surjective (f : H →ₐc[k] J) (hf : Function.Surjective f) :
    Function.Surjective (scalarExtendBialgHom (F := F) f) := by
  intro z
  induction z using TensorProduct.induction_on with
  | zero => exact ⟨0, map_zero _⟩
  | add x y hx hy =>
    obtain ⟨u, rfl⟩ := hx
    obtain ⟨v, rfl⟩ := hy
    exact ⟨u + v, map_add _ _ _⟩
  | tmul a x =>
    obtain ⟨u, rfl⟩ := hf x
    exact ⟨a ⊗ₜ[k] u, scalarExtendBialgHom_tmul f a u⟩

/-- The kernel ideal after scalar extension is generated by the original kernel ideal. -/
theorem scalarExtendBialgHom_ker (f : H →ₐc[k] J) :
    RingHom.ker ((scalarExtendBialgHom (F := F) f : F ⊗[k] H →ₐ[F] F ⊗[k] J).toRingHom) =
      (RingHom.ker (f : H →ₐ[k] J).toRingHom).map
        (Algebra.TensorProduct.includeRight : H →ₐ[k] F ⊗[k] H) := by
  let p : H →ₐ[k] J := f
  change RingHom.ker (Algebra.TensorProduct.map (AlgHom.id F F) p).toRingHom =
    (RingHom.ker p.toRingHom).map (Algebra.TensorProduct.includeRight : H →ₐ[k] F ⊗[k] H)
  have h : (Algebra.TensorProduct.map (AlgHom.id F F) p).toRingHom =
      (Algebra.TensorProduct.map (AlgHom.id k F) p).toRingHom := by
    apply RingHom.ext
    intro z
    induction z using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | add x y hx hy => simp only [map_add, hx, hy]
    | tmul a x => rfl
  rw [h, ← Submodule.restrictScalars_inj k]
  change LinearMap.ker (p.toLinearMap.lTensor F) =
    ((RingHom.ker p.toRingHom).map (Algebra.TensorProduct.includeRight : H →ₐ[k] F ⊗[k] H)).restrictScalars k
  rw [Ideal.map_includeRight_eq,
    (Module.Flat.lTensor_exact F p.toLinearMap.exact_subtype_ker_map).linearMap_ker_eq]
  rfl

variable {I : Ideal H} {I' : Ideal (F ⊗[k] H)}

private theorem scalarExtendQuotient_ker (hI : IsHopfIdeal k I)
    (hMap : I.map (Algebra.TensorProduct.includeRight : H →ₐ[k] F ⊗[k] H) = I') :
    letI := hI.quotientHopf
    RingHom.ker ((scalarExtendBialgHom (F := F) hI.quotientBialgHom :
      F ⊗[k] H →ₐ[F] F ⊗[k] (H ⧸ I)).toRingHom) = I' := by
  letI := hI.quotientHopf
  rw [scalarExtendBialgHom_ker,
    show RingHom.ker (hI.quotientBialgHom : H →ₐ[k] H ⧸ I).toRingHom = I from Ideal.mk_ker, hMap]

/-- The quotient by an extended Hopf ideal is the scalar extension of the Hopf quotient. -/
def hopfQuotientBaseChange (hI : IsHopfIdeal k I) (hI' : IsHopfIdeal F I')
    (hMap : I.map (Algebra.TensorProduct.includeRight : H →ₐ[k] F ⊗[k] H) = I') :
    letI := hI.quotientHopf
    letI := hI'.quotientHopf
    (F ⊗[k] (H ⧸ I)) ≃ₐc[F] ((F ⊗[k] H) ⧸ I') := by
  letI := hI.quotientHopf
  letI := hI'.quotientHopf
  let q := scalarExtendBialgHom (F := F) hI.quotientBialgHom
  exact (bialgEquiv_quotientOfKerEq hI' q
    (scalarExtendBialgHom_surjective _ (Ideal.Quotient.mkₐ_surjective k I))
    (scalarExtendQuotient_ker hI hMap).symm).symm

@[simp] theorem hopfQuotientBaseChange_symm_mk_tmul (hI : IsHopfIdeal k I) (hI' : IsHopfIdeal F I')
    (hMap : I.map (Algebra.TensorProduct.includeRight : H →ₐ[k] F ⊗[k] H) = I')
    (a : F) (x : H) :
    letI := hI.quotientHopf
    letI := hI'.quotientHopf
    (hopfQuotientBaseChange hI hI' hMap).symm (Ideal.Quotient.mk I' (a ⊗ₜ[k] x)) =
      a ⊗ₜ[k] Ideal.Quotient.mk I x := rfl

end WideE
