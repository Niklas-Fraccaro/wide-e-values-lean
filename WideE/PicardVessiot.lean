import WideE.Fiber
import WideE.OrdinaryPoint
import CandidateFaithfullyFlat
import FormalFundamentalMatrixUnit
import LaurentDerivativeConstants
import MatrixCandidateTorsorCriterion
import PVConstantHopfAlgebra
import Stage14LaurentPolynomialODEClosure

/-! The Picard–Vessiot torsor of a Laurent system, constructed in the ordinary
formal Laurent series at one as in §6. -/

open scoped TensorProduct WideE

noncomputable section

namespace WideE

open StrictEUnit

attribute [local instance 2000] Subalgebra.toCommRing
attribute [-instance] TensorProduct.leftModule

set_option synthInstance.maxHeartbeats 60000

variable {K : Type*} [Field K]

/-- Regular power series included in the ordinary Laurent series field. -/
def powerSeriesInLaurent (K : Type*) [Field K] : PowerSeries K →ₐ[K] LaurentSeries K where
  toRingHom := HahnSeries.ofPowerSeries ℤ K
  commutes' c := by
    change HahnSeries.ofPowerSeries ℤ K (algebraMap K (PowerSeries K) c) = _
    rw [PowerSeries.algebraMap_apply, LaurentSeries.algebraMap_apply]
    exact HahnSeries.ofPowerSeries_C c

/-- The Laurent coefficient ring embedded by expanding at the ordinary point. -/
def ordinaryLaurentEmbedding (K : Type*) [Field K] : LaurentPolynomial K →ₐ[K] LaurentSeries K :=
  (powerSeriesInLaurent K).comp (formalAtOne K)

theorem ordinaryLaurentEmbedding_injective : Function.Injective (ordinaryLaurentEmbedding K) :=
  HahnSeries.ofPowerSeries_injective.comp (formalAtOne_injective K)

scoped instance ordinaryLaurentAlgebra : Algebra (LaurentPolynomial K) (LaurentSeries K) :=
  (ordinaryLaurentEmbedding K).toRingHom.toAlgebra

scoped instance (priority := 2000) ordinaryLaurentBaseSMul :
    SMul (LaurentPolynomial K) (LaurentSeries K) := ordinaryLaurentAlgebra.toSMul

scoped instance ordinaryLaurentTower : IsScalarTower K (LaurentPolynomial K) (LaurentSeries K) :=
  ⟨fun c b x => by
    change ordinaryLaurentEmbedding K (c • b) * x = c • (ordinaryLaurentEmbedding K b * x)
    rw [Algebra.smul_def c b, map_mul, (ordinaryLaurentEmbedding K).commutes, mul_assoc]
    rw [LaurentSeries.algebraMap_apply, HahnSeries.C_apply, HahnSeries.single_zero_mul_eq_smul]⟩

theorem ordinaryLaurentEmbedding_derivation (b : LaurentPolynomial K) :
    laurentOrdinaryDerivation (algebraMap (LaurentPolynomial K) (LaurentSeries K) b) =
      algebraMap (LaurentPolynomial K) (LaurentSeries K) (laurentDerivation b) := by
  change laurentOrdinaryDerivation (HahnSeries.ofPowerSeries ℤ K (formalAtOne K b)) = _
  rw [laurentOrdinaryDerivation_ofPowerSeries, formalAtOne_derivative]
  rfl

variable {r : ℕ}
  (A : Matrix (Fin r) (Fin r) (LaurentPolynomial K))

/-- The formal matrix with constant term the identity. -/
def ordinaryFundamentalPower : Matrix (Fin r) (Fin r) (PowerSeries K) :=
  formalFundamentalMatrix (A.map (formalAtOne K))

theorem ordinaryFundamentalPower_atOne :
    (ordinaryFundamentalPower A).map (PowerSeries.constantCoeff K) = 1 :=
  formalFundamentalMatrix_constantCoeff _

def ordinaryFundamental : Matrix (Fin r) (Fin r) (LaurentSeries K) :=
  (ordinaryFundamentalPower A).map (powerSeriesInLaurent K)

theorem ordinaryFundamental_det_ne_zero : (ordinaryFundamental A).det ≠ 0 := by
  have hu := (formalFundamentalMatrix_isUnit (A.map (formalAtOne K))).map
    (powerSeriesInLaurent K).toRingHom.mapMatrix
  exact ((Matrix.isUnit_iff_isUnit_det _).mp hu).ne_zero

variable [CharZero K]

theorem ordinaryFundamental_derivation (i j : Fin r) :
    laurentOrdinaryDerivation (ordinaryFundamental A i j) =
      ∑ l, algebraMap (LaurentPolynomial K) (LaurentSeries K) (A i l) *
        ordinaryFundamental A l j := by
  have h := congrArg (fun M : Matrix (Fin r) (Fin r) (PowerSeries K) =>
    (powerSeriesInLaurent K) (M i j))
    (formalFundamentalMatrix_derivative (A.map (formalAtOne K)))
  change laurentOrdinaryDerivation (HahnSeries.ofPowerSeries ℤ K (ordinaryFundamentalPower A i j)) = _
  rw [laurentOrdinaryDerivation_ofPowerSeries]
  simpa only [ordinaryFundamental, ordinaryFundamentalPower, Matrix.map_apply,
    Matrix.mul_apply, map_sum, map_mul] using h

/-- The ring generated by the actual formal fundamental matrix and its inverse determinant. -/
abbrev ordinaryPVAlgebra := matrixGeneratedAlgebra (B := LaurentPolynomial K) (ordinaryFundamental A)

local instance ordinaryPVCommRing : CommRing (ordinaryPVAlgebra A) :=
  (ordinaryPVAlgebra A).toCommRing

local instance ordinaryPVAddCommGroup : AddCommGroup (ordinaryPVAlgebra A) :=
  (ordinaryPVCommRing A).toAddCommGroup

local instance ordinaryPVAddCommMonoid : AddCommMonoid (ordinaryPVAlgebra A) :=
  (ordinaryPVAlgebra A).toSemiring.toAddCommMonoid

local instance ordinaryPVBaseAlgebra : Algebra (LaurentPolynomial K) (ordinaryPVAlgebra A) :=
  (ordinaryPVAlgebra A).algebra

local instance ordinaryPVCoeffAlgebra : Algebra K (ordinaryPVAlgebra A) :=
  (ordinaryPVAlgebra A).algebra'

local instance ordinaryPVSelfModule : Module (ordinaryPVAlgebra A) (ordinaryPVAlgebra A) :=
  Semiring.toModule

local instance ordinaryPVCoeffModule : Module K (ordinaryPVAlgebra A) :=
  Algebra.toModule

local instance ordinaryPVBaseModule : Module (LaurentPolynomial K) (ordinaryPVAlgebra A) :=
  Algebra.toModule

local instance ordinaryPVMul : Mul (ordinaryPVAlgebra A) :=
  (ordinaryPVCommRing A).toMul

local notation "D" => stage14_laurentAlgebraDerivation (k := K)

def ordinaryPVDerivation : Derivation K (ordinaryPVAlgebra A) (ordinaryPVAlgebra A) := by
  exact candidateKDerivation (laurentDerivation (K := K)) D (ordinaryFundamental A) A
    ordinaryLaurentEmbedding_derivation (ordinaryFundamental_derivation A)

theorem ordinaryPVDerivation_base (b : LaurentPolynomial K) :
    ordinaryPVDerivation A (algebraMap _ (ordinaryPVAlgebra A) b) =
      algebraMap _ (ordinaryPVAlgebra A) (laurentDerivation b) :=
  candidateKDerivation_base (laurentDerivation (K := K)) D
    (ordinaryFundamental A) A
    ordinaryLaurentEmbedding_derivation (ordinaryFundamental_derivation A) b

def ordinaryPVMatrix : (Matrix (Fin r) (Fin r) (ordinaryPVAlgebra A))ˣ :=
  candidateMatrixUnit (ordinaryFundamental A) (ordinaryFundamental_det_ne_zero A)

theorem ordinaryPVMatrix_derivation :
    matrixDerivative (k := K) (R := ordinaryPVAlgebra A) (ordinaryPVDerivation A)
        (ordinaryPVMatrix A).val =
      (algebraMap (LaurentPolynomial K) (ordinaryPVAlgebra A)).mapMatrix A *
        (ordinaryPVMatrix A).val :=
  candidateKDerivation_ode laurentDerivation D (ordinaryFundamental A) A
    (ordinaryFundamental_det_ne_zero A) ordinaryLaurentEmbedding_derivation
    (ordinaryFundamental_derivation A)

theorem ordinaryPV_faithfullyFlat : Module.FaithfullyFlat (LaurentPolynomial K) (ordinaryPVAlgebra A) :=
  matrixGeneratedAlgebra_faithfullyFlat laurentDerivation D
    (ordinaryFundamental A) A (ordinaryFundamental_det_ne_zero A)
    ordinaryLaurentEmbedding_derivation (ordinaryFundamental_derivation A)
    laurentDerivation_stable_ideal_eq_top

theorem ordinaryPV_constants (x : ordinaryPVAlgebra A) (h : ordinaryPVDerivation A x = 0) :
    ∃ c : K, algebraMap K (ordinaryPVAlgebra A) c = x := by
  have hx : laurentOrdinaryDerivation x.val = 0 := congrArg Subtype.val h
  obtain ⟨c, hc⟩ := (laurentOrdinaryDerivation_eq_zero_iff_exists_constant x.val).mp hx
  exact ⟨c, Subtype.ext hc.symm⟩

/-- The coordinate algebra of the differential Galois group. -/
abbrev ordinaryPVGroup :=
  pvConstantAlgebra (k := K) (B := LaurentPolynomial K) (R := ordinaryPVAlgebra A)
    laurentDerivation (ordinaryPVDerivation A) (ordinaryPVDerivation_base A)

private theorem ordinaryAmbientConstants (x : LaurentSeries K) (hx : D x = 0) :
    ∃ c : K, algebraMap K (LaurentSeries K) c = x := by
  obtain ⟨c, hc⟩ := (laurentOrdinaryDerivation_eq_zero_iff_exists_constant x).mp hx
  exact ⟨c, hc.symm⟩

def ordinaryPV_chart :=
  haveI := ordinaryPV_faithfullyFlat A
  candidateConstantMultiplicationEquiv laurentDerivation D
    (ordinaryFundamental A) A (ordinaryFundamental_det_ne_zero A)
    ordinaryLaurentEmbedding_derivation (ordinaryFundamental_derivation A)
    ordinaryAmbientConstants

set_option maxHeartbeats 800000 in
def ordinaryPVHopf :=
  haveI := ordinaryPV_faithfullyFlat A
  pvConstantHopfAlgebra (k := K) (B := LaurentPolynomial K) (R := ordinaryPVAlgebra A)
    laurentDerivation (ordinaryPVDerivation A) (ordinaryPVDerivation_base A)
    (candidateConstantMultiplication_bijective laurentDerivation D (ordinaryFundamental A) A
      (ordinaryFundamental_det_ne_zero A) ordinaryLaurentEmbedding_derivation
      (ordinaryFundamental_derivation A) ordinaryAmbientConstants)
    (ordinaryPV_constants A)

end WideE
