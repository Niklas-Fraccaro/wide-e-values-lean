import WideE.LinearSubmoduleDescent
import Mathlib.RingTheory.TensorProduct.MvPolynomial
import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Ideal
import Mathlib.RingTheory.MvPolynomial.Homogeneous

/-! Ideal descent in multivariate polynomial coordinates. -/

open scoped TensorProduct

noncomputable section

namespace WideE

set_option maxHeartbeats 1600000
set_option synthInstance.maxHeartbeats 100000

section Coefficients

variable {ι R S B : Type*} [CommRing R] [CommRing S] [CommRing B] [Algebra R S] [Algebra R B]

private theorem polynomialTensor_map_tmul (f : S →ₐ[R] B) (s : S) (p : MvPolynomial ι R) :
    MvPolynomial.map f.toRingHom (MvPolynomial.algebraTensorAlgEquiv R S (s ⊗ₜ[R] p)) =
      MvPolynomial.algebraTensorAlgEquiv R B (f s ⊗ₜ[R] p) := by
  simp only [MvPolynomial.algebraTensorAlgEquiv_tmul, Algebra.smul_def, MvPolynomial.algebraMap_eq,
    map_mul, MvPolynomial.map_C, MvPolynomial.map_map]
  have hf : f.toRingHom.comp (algebraMap R S) = algebraMap R B := RingHom.ext f.commutes
  rw [hf]
  rfl

end Coefficients

section Ideals

variable {ι R S : Type*} [CommRing R] [CommRing S] [Algebra R S]

local notation "PR" => MvPolynomial ι R
local notation "PS" => MvPolynomial ι S
local notation "C" => S ⊗[R] S
local notation "PC" => MvPolynomial ι C
local notation "T" => S ⊗[R] PR
local notation "V" => S ⊗[R] (S ⊗[R] PR)
local notation "left" => (Algebra.TensorProduct.includeLeft : S →ₐ[R] C)
local notation "right" => (Algebra.TensorProduct.includeRight : S →ₐ[R] C)
local notation "firstPull" => scalarDescentFirstPull R S PR
local notation "secondPull" => (Algebra.TensorProduct.includeRight : T →ₐ[R] V)
local notation "base" => (Algebra.TensorProduct.includeRight : PR →ₐ[R] T)
local notation "pmap" => MvPolynomial.map (σ := ι) (algebraMap R S)

private def polynomialOverlapEquiv : V ≃+* PC :=
  (Algebra.TensorProduct.assoc R S S PR).symm.toRingEquiv.trans
    (MvPolynomial.algebraTensorAlgEquiv (σ := ι) R C).toRingEquiv

private theorem polynomialOverlapEquiv_first :
    (polynomialOverlapEquiv (ι := ι) (R := R) (S := S)).toRingHom.comp (firstPull).toRingHom =
      (MvPolynomial.map (left).toRingHom).comp (MvPolynomial.algebraTensorAlgEquiv R S).toRingHom := by
  apply RingHom.ext
  intro x
  induction x with
  | zero => simp only [map_zero]
  | add x y hx hy => simp only [map_add, hx, hy]
  | tmul s p =>
    change MvPolynomial.algebraTensorAlgEquiv R C ((left s) ⊗ₜ[R] p) =
      MvPolynomial.map (left).toRingHom (MvPolynomial.algebraTensorAlgEquiv R S (s ⊗ₜ[R] p))
    exact (polynomialTensor_map_tmul left s p).symm

private theorem polynomialOverlapEquiv_second :
    (polynomialOverlapEquiv (ι := ι) (R := R) (S := S)).toRingHom.comp (secondPull).toRingHom =
      (MvPolynomial.map (right).toRingHom).comp (MvPolynomial.algebraTensorAlgEquiv R S).toRingHom := by
  apply RingHom.ext
  intro x
  induction x with
  | zero => simp only [map_zero]
  | add x y hx hy => simp only [map_add, hx, hy]
  | tmul s p =>
    change MvPolynomial.algebraTensorAlgEquiv R C ((right s) ⊗ₜ[R] p) =
      MvPolynomial.map (right).toRingHom (MvPolynomial.algebraTensorAlgEquiv R S (s ⊗ₜ[R] p))
    exact (polynomialTensor_map_tmul right s p).symm

/-- In polynomial coordinates, equality of the two pullbacks suffices for an
ideal over a flat scalar extension to be generated by its contraction. -/
theorem polynomialIdeal_descends_of_equal_pulls [Module.Flat R S] (I : Ideal PS)
    (hI : I.map (MvPolynomial.map (left).toRingHom) = I.map (MvPolynomial.map (right).toRingHom)) :
    (I.comap pmap).map pmap = I := by
  let e := MvPolynomial.algebraTensorAlgEquiv (σ := ι) R S
  let e' := polynomialOverlapEquiv (ι := ι) (R := R) (S := S)
  let J := I.comap e.toRingHom
  have hJ : J.map e.toRingHom = I := Ideal.map_comap_of_surjective e.toRingHom e.surjective I
  have hPull : J.map firstPull = J.map secondPull := by
    apply (Ideal.relIsoOfBijective e'.toRingHom e'.bijective).symm.injective
    change (J.map (firstPull).toRingHom).map e'.toRingHom =
      (J.map (secondPull).toRingHom).map e'.toRingHom
    rw [Ideal.map_map, Ideal.map_map, polynomialOverlapEquiv_first, polynomialOverlapEquiv_second]
    change J.map ((MvPolynomial.map (left).toRingHom).comp e.toRingHom) =
      J.map ((MvPolynomial.map (right).toRingHom).comp e.toRingHom)
    rw [← Ideal.map_map, ← Ideal.map_map, hJ]
    exact hI
  have hbase : e.toRingHom.comp (base).toRingHom = pmap := by
    apply RingHom.ext
    intro p
    change e ((1 : S) ⊗ₜ[R] p) = pmap p
    rw [MvPolynomial.algebraTensorAlgEquiv_tmul, one_smul]
  have hJbase : J.comap (base).toRingHom = I.comap pmap := by
    change (I.comap e.toRingHom).comap (base).toRingHom = I.comap pmap
    rw [Ideal.comap_comap, hbase]
  have h := congrArg (Ideal.map e.toRingHom) (ideal_descends_of_equal_pulls J hPull)
  change ((J.comap (base).toRingHom).map (base).toRingHom).map e.toRingHom = J.map e.toRingHom at h
  rwa [Ideal.map_map, hbase, hJbase, hJ] at h

end Ideals

section Grading

attribute [local instance] MvPolynomial.gradedAlgebra

variable {ι R S : Type*} [CommRing R] [CommRing S]

/-- The projection to a homogeneous degree commutes with coefficient maps. -/
theorem map_polynomial_homogeneousComponent (f : R →+* S) (p : MvPolynomial ι R) (d : ℕ) :
    MvPolynomial.map f (MvPolynomial.homogeneousComponent d p) =
      MvPolynomial.homogeneousComponent d (MvPolynomial.map f p) := by
  apply MvPolynomial.ext
  intro m
  simp only [MvPolynomial.coeff_map, MvPolynomial.coeff_homogeneousComponent]
  split_ifs <;> simp only [map_zero]

private theorem polynomialGradedProjection_eq {d : ℕ} (p : MvPolynomial ι R) :
    GradedRing.proj (MvPolynomial.homogeneousSubmodule ι R) d p =
      MvPolynomial.homogeneousComponent d p := by
  rw [GradedRing.proj_apply]
  exact MvPolynomial.decomposition.decompose'_apply p d

/-- Contracting a homogeneous polynomial ideal preserves homogeneity. -/
theorem polynomialIdeal_comap_isHomogeneous (f : R →+* S) {I : Ideal (MvPolynomial ι S)}
    (hI : I.IsHomogeneous (MvPolynomial.homogeneousSubmodule ι S)) :
    (I.comap (MvPolynomial.map f)).IsHomogeneous (MvPolynomial.homogeneousSubmodule ι R) := by
  apply (Ideal.isHomogeneous_iff_forall_subset _ _).mpr
  intro d p hp
  change MvPolynomial.map f (GradedRing.proj (MvPolynomial.homogeneousSubmodule ι R) d p) ∈ I
  rw [polynomialGradedProjection_eq, map_polynomial_homogeneousComponent, ← polynomialGradedProjection_eq]
  exact (Ideal.isHomogeneous_iff_forall_subset _ _).mp hI d hp

end Grading

end WideE
