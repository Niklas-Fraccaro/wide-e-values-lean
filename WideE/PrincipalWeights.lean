import WideE.PrincipalSl2
import WideE.RootBaseExistence
import WideE.Sl2WeightSplitting

/-!
# Principal adjoint weights

The Cartan element for a base acts on each root space with twice its
integral root height. Its zero weight space is the Cartan subalgebra.
-/

noncomputable section

open LieAlgebra LieAlgebra.IsKilling LieModule

namespace WideE

variable {k L : Type*} [Field k] [CharZero k] [LieRing L] [LieAlgebra k L]
  [LieAlgebra.IsKilling k L] [FiniteDimensional k L]
variable {H : LieSubalgebra k L} [H.IsCartanSubalgebra] [LieModule.IsTriangularizable k H L]

local notation "Φ" => LieAlgebra.IsKilling.rootSystem H

/-- The subgroup of Cartan isomorphisms generated by the simple coreflections. -/
def principalSimpleCoreflectionSubgroup (b : (Φ).Base) : Subgroup (H ≃ₗ[k] H) :=
  Subgroup.closure (Set.range fun i : b.support => (Φ).coreflection i)

/-- For a nonzero split semisimple Lie algebra, every root base has a simple root. -/
theorem principalRootBase_nonempty_support [Nontrivial L] (b : (Φ).Base) :
    Nonempty b.support := by
  classical
  by_contra hb
  letI : IsEmpty b.support := not_nonempty_iff.mp hb
  have hH : Subsingleton H := b.toCoweightBasis.repr.injective.subsingleton
  have hBot : H = ⊥ := by
    apply LieSubalgebra.toSubmodule_injective
    exact Submodule.subsingleton_iff_eq_bot.mp hH
  obtain ⟨x, hxNe⟩ := exists_ne (0 : L)
  have hx : x ∈ H.normalizer := by
    rw [LieSubalgebra.mem_normalizer_iff, hBot]
    intro y hy
    rw [LieSubalgebra.mem_bot] at hy
    simp [hy]
  rw [LieSubalgebra.IsCartanSubalgebra.self_normalizing, hBot, LieSubalgebra.mem_bot] at hx
  exact hxNe hx

/-- Existence of a principal triple for a nonzero split Killing Lie algebra. -/
theorem exists_principalSl2Triple [Nontrivial L] :
    ∃ (b : (Φ).Base) (e f : L), IsSl2Triple (principalCartanElement b : L) e f := by
  obtain ⟨b⟩ := rootSystem_nonempty_base Φ
  letI : Fintype b.support := Fintype.ofFinite _
  letI : Nonempty b.support := principalRootBase_nonempty_support b
  obtain ⟨e, f, _, _, _, h⟩ := exists_principalSl2Triple_of_rootBase b
  exact ⟨b, ∑ i, e i, ∑ i, principalCartanCoefficient b i • f i, h⟩

/-- Each root takes twice a nonzero integral height at the principal Cartan element. -/
theorem principalCartanElement_root_height (b : (Φ).Base) (α : H.root) :
    ∃ n : ℤ, n ≠ 0 ∧ (Φ).root α (principalCartanElement b) = ((2 * n : ℤ) : k) := by
  let ev : (H →ₗ[k] k) →ₗ[k] k := Module.Dual.eval k H (principalCartanElement b)
  let C := AddSubmonoid.closure ((Φ).root '' b.support)
  have hClosure {x : H →ₗ[k] k} (hx : x ∈ C) :
      ∃ n : ℕ, ev x = 2 * (n : k) ∧ (n = 0 → x = 0) := by
    refine AddSubmonoid.closure_induction (motive := fun x _ =>
      ∃ n : ℕ, ev x = 2 * (n : k) ∧ (n = 0 → x = 0)) ?_ ?_ ?_ hx
    · rintro x ⟨i, hi, rfl⟩
      refine ⟨1, ?_, by simp⟩
      change (Φ).root i (principalCartanElement b) = 2 * (1 : ℕ)
      simpa using principalCartanElement_simpleRoot b ⟨i, hi⟩
    · exact ⟨0, by simp, fun _ => rfl⟩
    · rintro x y _ _ ⟨m, hm, hmx⟩ ⟨n, hn, hny⟩
      refine ⟨m + n, ?_, ?_⟩
      · rw [map_add, hm, hn, Nat.cast_add, mul_add]
      · intro h
        rw [hmx (by omega), hny (by omega), zero_add]
  rcases b.root_mem_or_neg_mem α with h | h
  · obtain ⟨n, hn, hZero⟩ := hClosure h
    have hne : n ≠ 0 := fun h => (Φ).ne_zero α (hZero h)
    exact ⟨n, by exact_mod_cast hne, by simpa [ev] using hn⟩
  · obtain ⟨n, hn, hZero⟩ := hClosure h
    have hne : n ≠ 0 := fun h => (Φ).ne_zero α (neg_eq_zero.mp (hZero h))
    refine ⟨-(n : ℤ), by exact_mod_cast neg_ne_zero.mpr (Int.ofNat_ne_zero.mpr hne), ?_⟩
    rw [map_neg] at hn
    have hEq := congrArg Neg.neg hn
    simpa [ev, mul_neg] using hEq

/-- The adjoint eigenspace for twice the indicated integral principal weight. -/
def principalWeightSpace (b : (Φ).Base) (n : ℤ) : Submodule k L :=
  sl2WeightSpace (k := k) (M := L) (principalCartanElement b : L) (2 * n)

theorem principalRootSpace_le_weightSpace (b : (Φ).Base) (α : H.root) {n : ℤ}
    (hn : (Φ).root α (principalCartanElement b) = ((2 * n : ℤ) : k)) :
    (rootSpace H ((((Φ).root α : H →ₗ[k] k) : H → k))).toSubmodule ≤
      principalWeightSpace b n := by
  intro x hx
  apply Module.End.mem_eigenspace_iff.mpr
  exact (lie_eq_smul_of_mem_rootSpace hx (principalCartanElement b)).trans
    (congrArg (fun c : k => c • x) hn)

private theorem principalCartan_le_zeroWeight (b : (Φ).Base) :
    H.toSubmodule ≤ principalWeightSpace b 0 := by
  intro x hx
  apply Module.End.mem_eigenspace_iff.mpr
  have hx' : x ∈ rootSpace H 0 := by rw [rootSpace_zero_eq]; exact hx
  simpa using lie_eq_smul_of_mem_rootSpace hx' (principalCartanElement b)

private theorem principalCartan_sup_nonzeroWeight (b : (Φ).Base) :
    H.toSubmodule ⊔ (⨆ n : {n : ℤ // n ≠ 0}, principalWeightSpace b n.val) = ⊤ := by
  classical
  apply eq_top_iff.mpr
  rw [← LieSubmodule.iSup_toSubmodule_eq_top.mpr (iSup_genWeightSpace_eq_top k H L)]
  apply iSup_le
  intro α
  by_cases hα : α = 0
  · subst α
    rw [show genWeightSpace L (0 : H → k) = H.toLieSubmodule from rootSpace_zero_eq k L H]
    exact le_sup_left
  · by_cases hSpace : rootSpace H α = ⊥
    · change (rootSpace H α).toSubmodule ≤ _
      rw [hSpace, LieSubmodule.bot_toSubmodule]
      exact bot_le
    · let β : Weight k H L := ⟨α, hSpace⟩
      let r : H.root := ⟨β, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hα⟩⟩
      obtain ⟨n, hn, hWeight⟩ := principalCartanElement_root_height b r
      exact (principalRootSpace_le_weightSpace b r hWeight).trans
        ((le_iSup (fun n : {n : ℤ // n ≠ 0} => principalWeightSpace b n.val)
          ⟨n, hn⟩).trans le_sup_right)

/-- The principal adjoint grading exhausts the Lie algebra. -/
theorem iSup_principalWeightSpace_eq_top (b : (Φ).Base) :
    (⨆ n : ℤ, principalWeightSpace b n) = ⊤ := by
  apply eq_top_iff.mpr
  rw [← principalCartan_sup_nonzeroWeight b]
  exact sup_le ((principalCartan_le_zeroWeight b).trans (le_iSup _ 0))
    (iSup_le fun n => le_iSup _ n.val)

/-- The degree zero part of the principal adjoint grading is the Cartan subalgebra. -/
theorem principalWeightSpace_zero_eq_cartan (b : (Φ).Base) :
    principalWeightSpace b 0 = H.toSubmodule := by
  let V := ⨆ n : {n : ℤ // n ≠ 0}, principalWeightSpace b n.val
  have hIndep : iSupIndep (principalWeightSpace b) := by
    apply (LieModule.toEnd k L L (principalCartanElement b : L)).eigenspaces_iSupIndep.comp
    intro i j hij
    have h := Int.cast_injective hij
    omega
  have hDisj : Disjoint (principalWeightSpace b 0) V := by
    refine (iSupIndep_def.mp hIndep 0).mono_right ?_
    apply iSup_le
    intro n
    exact le_iSup₂ (f := fun j (_ : j ≠ 0) => principalWeightSpace b j) n.val n.property
  apply le_antisymm _ (principalCartan_le_zeroWeight b)
  intro x hx
  have hx' : x ∈ H.toSubmodule ⊔ V := by rw [principalCartan_sup_nonzeroWeight b]; trivial
  obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.mp hx'
  have hz₀ : z ∈ principalWeightSpace b 0 := by
    simpa using (principalWeightSpace b 0).sub_mem hx (principalCartan_le_zeroWeight b hy)
  have hz' := Submodule.disjoint_def.mp hDisj z hz₀ hz
  simpa [hz'] using hy

end WideE
